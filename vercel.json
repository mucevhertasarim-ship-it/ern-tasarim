{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/ogrenci",
      "destination": "/ogrenci.html"
    },
    {
      "source": "/reklam",
      "destination": "/reklam.html"
    },
    {
      "source": "/mesaj",
      "destination": "/mesaj.html"
    },
    {
      "source": "/indir/ogrenci-apk",
      "destination": "/ERN_Tasarim_Ogrenci.apk"
    },
    {
      "source": "/indir/ogrenci-atolyesi",
      "destination": "https://raw.githubusercontent.com/mucevhertasarim-ship-it/mucevhertasarim-akademi/main/ERN_Tasarim_Ogrenci_Atolyesi_Setup.zip"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*).apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"ERN_Tasarim_Ogrenci.apk\""
        }
      ]
    },
    {
      "source": "/models/(.*).glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}